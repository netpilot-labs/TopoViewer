{{/* Rendered by the containerlab library pinned in go.mod (v0.83.0); its FuncMap has no "split" (containerlab-mcp#389). */}}
{
    "name": "{{ .Name }}",
    "type": "{{ .Type }}",
    {{ $labName := .Name }}
    {{ $type := .Type }}
    "clab": {
        "config": {
        "prefix": "{{ .Clab.Config.Prefix }}",
        "mgmt": {{ ToJSONPretty .Clab.Config.Mgmt "      " "  "}}
        }
    },
"nodes": [
    {{- $i:=0 }}{{range $n, $c := .NodeConfigs}}{{if $i}},{{end}}
    {
        "id": "{{$n}}",
        "index": "{{$c.Index}}",
        "shortname": "{{$c.ShortName}}",
        "longname": "{{$c.LongName}}",
        "fqdn": "{{$c.Fqdn}}",
        "group": "{{$c.Group}}",
        "labdir": "{{$c.LabDir}}",
        "kind": "{{$c.Kind}}",
        "image": "{{$c.Image}}",
        "mgmt-net": "{{$c.MgmtNet}}",
        "mgmt-intf": "{{$c.MgmtIntf}}",
        "mgmt-ipv4-address": "{{$c.MgmtIPv4Address}}",
        "mgmt-ipv4-prefix-length": {{$c.MgmtIPv4PrefixLength}},
        "mgmt-ipv6-address": "{{$c.MgmtIPv6Address}}",
        "mgmt-ipv6-prefix-length": {{$c.MgmtIPv6PrefixLength}},
        "mac-address": "{{$c.MacAddress}}",
        "labels": {{ToJSONPretty $c.Labels "      " "  "}}
        {{$i = add $i 1}}}{{end}}
    ],
"links": [{{range $i, $l := .Clab.Links}}{{if $i}},{{end}}
    {{- $eps :=  $l.GetEndpoints }}
    {{- $ep :=  index $eps 0 }}
    {{- $nodeA := $ep.GetNode.GetShortName }}
    {
        "a": {
            "node": "{{ $nodeA }}",
            "nodeLongName": "{{ $type }}-{{ $labName}}-{{ $nodeA }}",
            "interface": "{{ $ep.GetIfaceName }}",
            "mac": "{{ $ep.GetMac }}",
            "peer": "z"
        },
    {{- $ep :=  index $eps 1 }}
    {{- $nodeZ := $ep.GetNode.GetShortName }}
        "z": {
            "node": "{{ $nodeZ }}",
            "nodeLongName": "{{ $type }}-{{ $labName}}-{{ $nodeZ }}",
            "interface": "{{ $ep.GetIfaceName }}",
            "mac": "{{ $ep.GetMac }}",
            "peer": "a"
        }
    }{{end}}
    ]
}